rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Vault files: read/write gated by authenticated user + size limit.
    // Ownership is enforced at the app layer (only dirty items for the
    // current user are uploaded).
    match /paintings/{id}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }
    match /artists/{id}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }
    match /documents/{id}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }
    match /condition_reports/{id}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Profile photos: owner-scoped, uploaded by the signed-in user.
    match /profile/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Public gallery pages: readable by anyone with a live link.
    match /public_galleries/{uid}/{token}/page.html {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Deny access to everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
