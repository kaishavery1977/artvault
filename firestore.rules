rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
    function incomingOwnedByMe() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Vault collections: every document belongs to exactly one user and can
    // only be read/written by that user. Queries must filter by ownerUid.
    // Field-level limits prevent resource exhaustion (arrays capped, strings
    // length-checked) — Firestore enforces 1 MiB per document server-side.
    match /paintings/{id} {
      allow read, delete: if isOwner();
      allow create: if incomingOwnedByMe()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && request.resource.data.description.size() <= 5000
        && request.resource.data.tags.size() <= 50
        && request.resource.data.images.size() <= 20
        && request.resource.data.imageUrls.size() <= 20
        && request.resource.data.aiTags.size() <= 50
        && request.resource.data.dominantColors.size() <= 10;
      allow update: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title.size() <= 500
        && request.resource.data.description.size() <= 5000
        && request.resource.data.tags.size() <= 50
        && request.resource.data.images.size() <= 20
        && request.resource.data.imageUrls.size() <= 20;
    }
    match /artists/{id} {
      allow read, delete: if isOwner();
      allow create: if incomingOwnedByMe()
        && request.resource.data.name.size() <= 300
        && request.resource.data.biography.size() <= 5000
        && request.resource.data.awards.size() <= 20
        && request.resource.data.exhibitions.size() <= 20;
      allow update: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name.size() <= 300
        && request.resource.data.biography.size() <= 5000;
    }
    match /documents/{id} {
      allow read, delete: if isOwner();
      allow create: if incomingOwnedByMe()
        && request.resource.data.name.size() <= 300;
      allow update: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name.size() <= 300;
    }
    match /condition_reports/{id} {
      allow read, delete: if isOwner();
      allow create: if incomingOwnedByMe();
      allow update: if isOwner() && request.resource.data.ownerUid == request.auth.uid;
    }
    match /notifications/{id} {
      allow read, delete: if isOwner();
      allow create: if incomingOwnedByMe();
      allow update: if isOwner() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Backups are keyed by the owning user's uid.
    // Limit backup size to prevent unbounded growth on the free plan.
    match /backups/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid
        && request.resource.data.paintings.size() <= 500
        && request.resource.data.artists.size() <= 200
        && request.resource.data.documents.size() <= 200;
    }

    // Public-gallery link documents (keyed by the owner's uid) hold the
    // secret token, the active flag and the expiry time that the storage
    // rules check on every page read. Owner-private: only the owner may
    // read or change their own link's state.
    match /public_galleries/{uid} {
      allow read, delete: if isSignedIn() && uid == request.auth.uid;
      allow create: if incomingOwnedByMe() && uid == request.auth.uid;
      allow update: if isSignedIn() && uid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      // Per-link view analytics. The counter doc is written by the
      // anonymous page viewer (the gallery page is public), so writes are
      // intentionally unauthenticated — but only the views counter can
      // move, and only upward, and only for the doc whose name matches the
      // link's current secret token (so a revoked or re-published link can
      // never receive forged increments). The owner reads it through the
      // signed-in path above.
      match /stats/{stat} {
        allow read: if isSignedIn() && uid == request.auth.uid;
        allow create: if request.auth == null
          && stat == get(/databases/$(database)/documents/public_galleries/$(uid)).data.token
          && request.resource.data.views is int
          && request.resource.data.views == 1;
        allow update: if request.auth == null
          && stat == get(/databases/$(database)/documents/public_galleries/$(uid)).data.token
          && request.resource.data.views is int
          && request.resource.data.views == resource.data.views + 1;
      }
    }

    // Bootstrap: the secret code that grants the very first admin.
    // Any signed-in user may read bootstrap/config to verify the admin code
    // (AdminCodeGateScreen fetches it live so rotation works without an app
    // update). Only admins may rotate/delete it.
    match /bootstrap/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Revoked accounts: when an admin revokes a user, a marker doc is left
    // here so the account can't re-create its profile (remote sign-out).
    // Admins can read/manage any marker; a signed-in user may read only
    // their own marker so sign-in can show the revocation message instead
    // of a raw permission error.
    match /revoked/{uid} {
      allow read: if isAdmin() || (isSignedIn() && uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // User profiles: readable by every signed-in user (the admin panel lists
    // users, and profile lookups read this collection). Writes are
    // self-service for profile fields; nobody can self-promote to admin
    // except with a valid bootstrap code, and revoked accounts cannot
    // re-create their profile.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/revoked/$(uid))
        && request.resource.data.plan in ['free', 'pro']
        && (request.resource.data.role == 'curator'
            || request.resource.data.role == 'viewer'
            || (request.resource.data.role == 'admin'
                && request.resource.data.bootstrapCode
                   == get(/databases/$(database)/documents/bootstrap/config).data.adminCode));
      allow update: if (isSignedIn() && uid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
        && request.resource.data.role == resource.data.role
        && (request.resource.data.plan == resource.data.plan || isAdmin()))
        || (isAdmin() && uid != request.auth.uid);
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Role-change audit trail: written by admins when they change someone's
    // role, readable only by admins (shown in the Users screen history).
    match /role_audit/{doc} {
      allow create: if isAdmin();
      allow read, list: if isAdmin();
      allow update, delete: if false;
    }
  }
}
