# ArtVault password-reset email backend — configuration reference.
#
# Copy this file to `.env` for local emulation, and set the secret via:
#   firebase functions:secrets:set GMAIL_APP_PASSWORD
# (non-secret params can also be deployed via `.env.<project-id>`).

# SMTP relay
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SSL | START_TLS | NONE
SMTP_SECURITY=SSL
SMTP_USERNAME=kaishavery1977@gmail.com
SMTP_SENDER=kaishavery1977@gmail.com
SMTP_SENDER_NAME=ArtVault

# Where the user lands after the reset completes.
RESET_CONTINUE_URL=https://artvault-d69d0.firebaseapp.com

# Secret (set via `firebase functions:secrets:set GMAIL_APP_PASSWORD`, or
# in `.env` for local emulation only): the Gmail APP password (16 chars),
# NOT the account password.
GMAIL_APP_PASSWORD=
